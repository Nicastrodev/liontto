@* Views/Materiais/Editar.cshtml *@
@model Material
@{ ViewData["Title"] = "Editar Material"; }

<div class="card" style="max-width:600px;">
    <form method="post" asp-action="Editar" asp-controller="Materiais" asp-route-id="@Model.Id" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>

        <div class="form-grid">
            <div class="form-group" style="grid-column:1/-1;">
                <label asp-for="Nome">Nome do Material *</label>
                <input asp-for="Nome"/>
                <span asp-validation-for="Nome"></span>
            </div>
            <div class="form-group">
                <label asp-for="Unidade">Unidade de Medida *</label>
                <select asp-for="Unidade">
                    @foreach (var u in new[]{"m²","metro","unidade","par","kg","litro","caixa","rolo"})
                    {
                        <option value="@u">@u</option>
                    }
                </select>
                <span asp-validation-for="Unidade"></span>
            </div>
            <div class="form-group">
                <label asp-for="QuantidadeMinima">Quantidade Minima</label>
                <input asp-for="QuantidadeMinima" type="text" inputmode="decimal" placeholder="Ex: 5 ou 5,5"/>
                <span asp-validation-for="QuantidadeMinima"></span>
            </div>
            <div class="form-group">
                <label asp-for="PrecoUnitario">Preco Unitario (R$)</label>
                <input asp-for="PrecoUnitario" type="text" inputmode="decimal" placeholder="Ex: R$ 18,50 ou 2.300,00"/>
                <span asp-validation-for="PrecoUnitario"></span>
            </div>
        </div>

        <input type="hidden" name="Quantidade" value="@Model.Quantidade"/>
        <input type="hidden" name="CriadoEm" value="@Model.CriadoEm.ToString("o")"/>
        <div class="divider"></div>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">Salvar Alteracoes</button>
            <a href="/Materiais" class="btn btn-outline">Cancelar</a>
        </div>
    </form>
</div>
