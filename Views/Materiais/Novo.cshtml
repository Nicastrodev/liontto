@* Views/Materiais/Novo.cshtml *@
@model Material
@{ ViewData["Title"] = "Novo Material"; }

<div class="card" style="max-width:600px;">
    <form method="post" asp-action="Novo" asp-controller="Materiais" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>

        <div class="form-grid">
            <div class="form-group" style="grid-column:1/-1;">
                <label asp-for="Nome">Nome do Material *</label>
                <input asp-for="Nome" placeholder="Ex: MDF 15mm Branco"/>
                <span asp-validation-for="Nome"></span>
            </div>
            <div class="form-group">
                <label asp-for="Unidade">Unidade de Medida *</label>
                <select asp-for="Unidade">
                    <option value="">Selecione...</option>
                    @foreach (var u in new[]{"m²","metro","unidade","par","kg","litro","caixa","rolo"})
                    {
                        <option value="@u">@u</option>
                    }
                </select>
                <span asp-validation-for="Unidade"></span>
            </div>
            <div class="form-group">
                <label asp-for="Quantidade">Quantidade Inicial</label>
                <input asp-for="Quantidade" type="text" inputmode="decimal" placeholder="Ex: 10 ou 10,5"/>
                <span asp-validation-for="Quantidade"></span>
            </div>
            <div class="form-group">
                <label asp-for="QuantidadeMinima">Quantidade Minima (Alerta)</label>
                <input asp-for="QuantidadeMinima" type="text" inputmode="decimal" placeholder="Ex: 5 ou 5,5"/>
                <span class="form-hint">Alerta quando o estoque cair abaixo deste valor.</span>
                <span asp-validation-for="QuantidadeMinima"></span>
            </div>
            <div class="form-group">
                <label asp-for="PrecoUnitario">Preco Unitario (R$)</label>
                <input asp-for="PrecoUnitario" type="text" inputmode="decimal" placeholder="Ex: R$ 18,50 ou 2.300,00"/>
                <span asp-validation-for="PrecoUnitario"></span>
            </div>
        </div>

        <div class="divider"></div>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">Cadastrar Material</button>
            <a href="/Materiais" class="btn btn-outline">Cancelar</a>
        </div>
    </form>
</div>
