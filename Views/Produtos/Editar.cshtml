@* Views/Produtos/Editar.cshtml *@
@model ProdutoFormViewModel
@{ ViewData["Title"] = "Editar Produto"; }

<div class="card" style="max-width:820px;">
    <form method="post" action="/Produtos/Editar/@Model.Produto.Id" id="form-produto" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>

        <input type="hidden" name="CriadoEm" value="@Model.Produto.CriadoEm.ToString("o")"/>

        <div class="form-grid">
            <div class="form-group" style="grid-column:1/-1;">
                <label>Nome do Produto *</label>
                <input type="text" name="Nome" value="@Model.Produto.Nome"/>
                @Html.ValidationMessage("Nome", null, new { @class = "field-validation-error" })
            </div>
            <div class="form-group" style="grid-column:1/-1;">
                <label>Descricao</label>
                <textarea name="Descricao_" placeholder="Medidas, acabamento, observacoes tecnicas">@Model.Produto.Descricao_</textarea>
                <span class="form-hint">Opcional.</span>
                @Html.ValidationMessage("Descricao_", null, new { @class = "field-validation-error" })
            </div>
            <div class="form-group">
                <label>Preco Base (R$) *</label>
                <input type="text" inputmode="decimal" name="PrecoBase" value="@Model.Produto.PrecoBase.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))" placeholder="Ex: R$ 18,50 ou 2.300,00"/>
                @Html.ValidationMessage("PrecoBase", null, new { @class = "field-validation-error" })
            </div>
            <div class="form-group">
                <label>Tempo de Producao (dias) *</label>
                <input type="number" name="TempoProducaoDias" value="@Model.Produto.TempoProducaoDias" min="1"/>
                @Html.ValidationMessage("TempoProducaoDias", null, new { @class = "field-validation-error" })
            </div>
        </div>

        <div class="divider"></div>
        <div class="mb-3">
            <strong>Materiais Necessarios</strong>
            <span class="form-hint">Adicione ao menos um material e a quantidade utilizada.</span>
            @Html.ValidationMessage("matIds", null, new { @class = "field-validation-error" })
            @Html.ValidationMessage("matQtds", null, new { @class = "field-validation-error" })
        </div>

        <div id="materiais-lista">
            @if (Model.Produto.Materiais.Any())
            {
                @foreach (var mat in Model.Produto.Materiais)
                {
                    <div class="material-row flex gap-2 mb-3" style="align-items:center;">
                        <select name="matIds" style="flex:2;">
                            <option value="">Selecione...</option>
                            @foreach (var m in Model.Materiais)
                            {
                                if (m.Id == mat.MaterialId)
                                {
                                    <option value="@m.Id" selected>@m.Nome (@m.Unidade)</option>
                                }
                                else
                                {
                                    <option value="@m.Id">@m.Nome (@m.Unidade)</option>
                                }
                            }
                        </select>
                        <input type="text" inputmode="decimal" name="matQtds" value="@mat.QuantidadeNecessaria.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))" placeholder="Quantidade" style="flex:1;"/>
                        <button type="button" onclick="this.parentElement.remove()" class="btn btn-danger btn-sm">Remover</button>
                    </div>
                }
            }
            else
            {
                <div class="material-row flex gap-2 mb-3" style="align-items:center;">
                    <select name="matIds" style="flex:2;">
                        <option value="">Selecione o material...</option>
                        @foreach (var m in Model.Materiais)
                        {
                            <option value="@m.Id">@m.Nome (@m.Unidade)</option>
                        }
                    </select>
                    <input type="text" inputmode="decimal" name="matQtds" placeholder="Quantidade" style="flex:1;"/>
                    <button type="button" onclick="this.parentElement.remove()" class="btn btn-danger btn-sm">Remover</button>
                </div>
            }
        </div>

        <div id="options-source" style="display:none;">
            @foreach (var m in Model.Materiais)
            {
                <option value="@m.Id">@m.Nome (@m.Unidade)</option>
            }
        </div>

        <button type="button" onclick="adicionarLinha()" class="btn btn-outline btn-sm mb-4">Adicionar Material</button>

        <div class="divider"></div>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">Salvar Alteracoes</button>
            <a href="/Produtos" class="btn btn-outline">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
function adicionarLinha() {
    const options = document.getElementById('options-source').innerHTML;
    const row = document.createElement('div');
    row.className = 'material-row flex gap-2 mb-3';
    row.style.alignItems = 'center';
    row.innerHTML = `
        <select name="matIds" style="flex:2;">
            <option value="">Selecione o material...</option>${options}
        </select>
        <input type="text" inputmode="decimal" name="matQtds" placeholder="Quantidade" style="flex:1;"/>
        <button type="button" onclick="this.parentElement.remove()" class="btn btn-danger btn-sm">Remover</button>`;
    document.getElementById('materiais-lista').appendChild(row);
}
</script>
}
