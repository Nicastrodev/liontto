@model List<Produto>
@{ ViewData["Title"] = "Catalogo de Produtos"; }

@section TopbarActions {
    <a href="/Produtos/Novo" class="btn btn-accent">
        <i class="bi bi-plus-circle" aria-hidden="true"></i>
        Novo Produto
    </a>
}

@if (Model.Any())
{
    <div class="card">
        <div class="table-wrapper">
            <table class="responsive-table">
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Descricao</th>
                        <th>Preco Base</th>
                        <th>Prod. (dias)</th>
                        <th>Materiais</th>
                        <th>Acoes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-600" data-label="Produto">@p.Nome</td>
                            <td class="text-muted" data-label="Descricao">@(string.IsNullOrEmpty(p.Descricao_) ? "-" : p.Descricao_)</td>
                            <td class="fw-600" data-label="Preco base" style="color:var(--accent);">@p.PrecoBase.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                            <td data-label="Producao"><span class="badge badge-info">@p.TempoProducaoDias dias</span></td>
                            <td data-label="Materiais"><span class="badge badge-secondary">@p.Materiais.Count mat.</span></td>
                            <td class="cell-actions" data-label="Acoes">
                                <div class="row-actions">
                                    <a href="/Produtos/Ver/@p.Id" class="btn btn-outline btn-sm">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                        Ver
                                    </a>
                                    <a href="/Produtos/Editar/@p.Id" class="btn btn-outline btn-sm">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                        Editar
                                    </a>
                                    <form method="post" action="/Produtos/Excluir/@p.Id"
                                          data-confirm="Remover o produto '@p.Nome'?">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                            Excluir
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <div class="icon"><i class="bi bi-grid" aria-hidden="true"></i></div>
            <h3>Nenhum produto cadastrado</h3>
            <a href="/Produtos/Novo" class="btn btn-primary mt-3">Cadastrar Produto</a>
        </div>
    </div>
}
